{
  "hosting": {
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/extract_batch_document_data",
        "function": "extract_batch_document_data"
      },
      {
        "source": "/api/extract_document_data",
        "function": "extract_document_data"
      },
      {
        "source": "/api/submit_audit_event",
        "function": "submit_audit_event"
      },
      {
        "source": "/api/api_status",
        "function": "api_status"
      },
      {
        "source": "/api/validate_document_text",
        "function": "validate_document_text"
      },
      {
        "source": "/api/log_audit_event",
        "function": "log_audit_event"
      },
      {
        "source": "/api/correct_document_text",
        "function": "correct_document_text"
      },
      {
        "source": "/api/format-draft",
        "function": "format_draft"
      },
      {
        "source": "/api/merge_entities",
        "function": "merge_entities"
      },
      {
        "source": "/api/inviteEmployee",
        "function": "inviteEmployee"
      },
      {
        "source": "/api/revokeEmployeeAccess",
        "function": "revokeEmployeeAccess"
      },
      {
        "source": "/api/finalize_validation",
        "function": "finalize_validation"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "venv",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "runtime": "python311"
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}