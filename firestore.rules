rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return getUserData().status != 'revoked';
    }

    function hasRole(role) {
      return isAuthenticated() && isActiveUser() && ('role' in request.auth.token) && request.auth.token.role == role;
    }

    function belongsToCartorio(cartorioId) {
      return isAuthenticated() && isActiveUser() && ('cartorio_id' in request.auth.token) && request.auth.token.cartorio_id == cartorioId;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      // Users can read their own data.
      allow read: if isOwner(userId);
      // Only admins or backend can write (for this simplified example, users can't modify their own roles/cartorio).
      allow write: if false;
    }

    // Cartorios Collection (Multi-tenant Root)
    match /cartorios/{cartorioId} {

      // Minutas Collection (deprecated, moved to root but kept here for backward compatibility)
      match /minutas/{minutaId} {
        // Any user belonging to the cartorio can read/write minutas
        allow read, write: if hasRole('super_admin') || belongsToCartorio(cartorioId);
      }

      // Audit Logs Collection
      match /audit_logs/{logId} {
        // Any user belonging to the cartorio can append to audit logs
        allow create: if hasRole('super_admin') || belongsToCartorio(cartorioId);

        // Only admins belonging to the cartorio can read audit logs
        allow read: if hasRole('super_admin') || (belongsToCartorio(cartorioId) && hasRole('cartorio_admin'));

        // Audit logs are immutable (no update or delete)
        allow update, delete: if false;
      }
    }

    // Global Minutas Collection
    match /minutas/{minutaId} {
      // Allow read/write if super_admin or user belongs to the cartorio associated with the minuta
      allow read, write: if hasRole('super_admin') || (
        (resource == null || belongsToCartorio(resource.data.cartorio_id)) &&
        (request.resource == null || belongsToCartorio(request.resource.data.cartorio_id))
      );
    }

    // Global Templates Collection
    match /templates/{templateId} {
      allow read: if hasRole('super_admin') || belongsToCartorio(resource.data.cartorio_id);
      allow write: if hasRole('super_admin') || (
        (resource == null || belongsToCartorio(resource.data.cartorio_id)) &&
        (request.resource == null || belongsToCartorio(request.resource.data.cartorio_id)) &&
        hasRole('cartorio_admin')
      );
    }
  }
}
