rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return getUserData().status != 'revoked';
    }

    function hasRole(role) {
      return isAuthenticated() && isActiveUser() && request.auth.token.role == role;
    }

    function belongsToCartorio(cartorioId) {
      return isAuthenticated() && isActiveUser() && request.auth.token.cartorio_id == cartorioId;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      // Users can read their own data.
      allow read: if isOwner(userId);
      // Only admins or backend can write (for this simplified example, users can't modify their own roles/cartorio).
      allow write: if false;
    }

    // Cartorios Collection (Multi-tenant Root)
    match /cartorios/{cartorioId} {

      // Minutas Collection
      match /minutas/{minutaId} {
        // Any user belonging to the cartorio can read/write minutas
        allow read, write: if belongsToCartorio(cartorioId);
      }

      // Audit Logs Collection
      match /audit_logs/{logId} {
        // Any user belonging to the cartorio can append to audit logs
        allow create: if belongsToCartorio(cartorioId);

        // Only admins belonging to the cartorio can read audit logs
        allow read: if belongsToCartorio(cartorioId) && (hasRole('cartorio_admin') || hasRole('super_admin'));

        // Audit logs are immutable (no update or delete)
        allow update, delete: if false;
      }
    }
  }
}
