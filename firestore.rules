rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      let doc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return doc != null ? doc.data : null;
    }

    function isActiveUser() {
      let data = getUserData();
      return data == null || !('status' in data) || data.status != 'revoked';
    }

    function hasRole(role) {
      return isAuthenticated() && isActiveUser() && ('role' in request.auth.token) && request.auth.token.role == role;
    }

    function belongsToCartorio(cartorioId) {
      return isAuthenticated() && isActiveUser() && ('cartorio_id' in request.auth.token) && request.auth.token.cartorio_id == cartorioId;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function hasValidSupportGrant(minutaId) {
      let grant = get(/databases/$(database)/documents/minutas/$(minutaId)).data.support_grant;
      return hasRole('super_admin') && grant != null && grant.expires_at > request.time;
    }

    // Users Collection
    match /users/{userId} {
      // Users can read their own data.
      allow read: if isOwner(userId) ||
                     hasRole('super_admin') ||
                     (hasRole('cartorio_admin') && belongsToCartorio(resource.data.cartorio_id));
      // Only admins or backend can write (for this simplified example, users can't modify their own roles/cartorio).
      allow write: if false;
    }

    // Cartorios Collection (Multi-tenant Root)
    match /cartorios/{cartorioId} {
      // super_admin should only have global bypass for listing/reading cartorios root docs
      allow read: if hasRole('super_admin') || belongsToCartorio(cartorioId);
      allow write: if hasRole('super_admin');
      allow create: if hasRole('super_admin');

      // Minutas Collection (deprecated, moved to root but kept here for backward compatibility)
      match /minutas/{minutaId} {
        allow read: if belongsToCartorio(cartorioId) || hasValidSupportGrant(minutaId);
        allow write: if belongsToCartorio(cartorioId) && request.resource.data.cartorio_id == cartorioId;
      }

      // Audit Logs Collection
      match /audit_logs/{logId} {
        allow create: if belongsToCartorio(cartorioId) && request.resource.data.cartorio_id == cartorioId;
        allow read: if belongsToCartorio(cartorioId) && hasRole('cartorio_admin');
        allow update, delete: if false;
      }
    }

    // Global Minutas Collection
    match /minutas/{minutaId} {
      allow read: if hasValidSupportGrant(minutaId) || (
        (resource == null || belongsToCartorio(resource.data.cartorio_id))
      );
      allow write: if (
        (resource == null || belongsToCartorio(resource.data.cartorio_id)) &&
        (request.resource == null || belongsToCartorio(request.resource.data.cartorio_id))
      );
    }

    // Global Templates Collection
    match /templates/{templateId} {
      allow read: if hasRole('super_admin') || (resource != null && (resource.data.cartorio_id == 'SYSTEM' || belongsToCartorio(resource.data.cartorio_id)));
      allow write: if hasRole('super_admin') || (
        (resource == null || (resource.data.cartorio_id != 'SYSTEM' && belongsToCartorio(resource.data.cartorio_id))) &&
        (request.resource == null || (request.resource.data.cartorio_id != 'SYSTEM' && belongsToCartorio(request.resource.data.cartorio_id))) &&
        hasRole('cartorio_admin')
      );
    }

    // Global Clauses Collection (Module 3)
    match /clauses/{clauseId} {
      allow read: if hasRole('super_admin') || (resource != null && (resource.data.cartorio_id == 'SYSTEM' || belongsToCartorio(resource.data.cartorio_id)));
      allow write: if hasRole('super_admin') || (
        (resource == null || (resource.data.cartorio_id != 'SYSTEM' && belongsToCartorio(resource.data.cartorio_id))) &&
        (request.resource == null || (request.resource.data.cartorio_id != 'SYSTEM' && belongsToCartorio(request.resource.data.cartorio_id))) &&
        hasRole('cartorio_admin')
      );
    }
  }
}
