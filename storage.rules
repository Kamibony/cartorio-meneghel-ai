rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isAuthenticated() && ('role' in request.auth.token) && request.auth.token.role == role;
    }

    function belongsToCartorio(cartorioId) {
      return isAuthenticated() && ('cartorio_id' in request.auth.token) && request.auth.token.cartorio_id == cartorioId;
    }

    match /cartorios/{cartorioId} {
      match /templates/{templateId} {
        // Any user in the cartorio can read templates for generation
        allow read: if hasRole('super_admin') || belongsToCartorio(cartorioId);
        // Only admins can upload/modify templates
        allow write: if hasRole('super_admin') || (belongsToCartorio(cartorioId) && hasRole('cartorio_admin'));
      }

      match /generated/{documentId} {
        // Any user in the cartorio can read/write generated documents
        allow read, write: if belongsToCartorio(cartorioId);
      }

      match /scans/{documentId} {
        // Restricted to cartorio users only for LGPD compliance
        allow read, write: if belongsToCartorio(cartorioId);
      }
    }
  }
}
